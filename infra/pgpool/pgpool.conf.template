# =============================================================================
# Pgpool-II - TechOrders U3
# Plantilla: las variables ${...} se reemplazan en entrypoint.sh con envsubst
# =============================================================================
backend_clustering_mode = 'streaming_replication'

listen_addresses = '*'
port = ${PGPOOL_PORT}
socket_dir = '/tmp'
pcp_listen_addresses = '*'
pcp_port = ${PCP_PORT}
pcp_socket_dir = '/tmp'
pid_file_name = '/tmp/pgpool.pid'
logdir = '/tmp'
log_destination = 'stderr'
log_line_prefix = '%t: pid %p: '
log_min_messages = warning

# ---------------------------------------------------------------- Backends
backend_hostname0 = '${PG1_HOST}'
backend_port0 = ${PG1_PORT}
backend_weight0 = 1
backend_flag0 = 'ALLOW_TO_FAILOVER'
backend_application_name0 = '${PG1_NAME}'

backend_hostname1 = '${PG2_HOST}'
backend_port1 = ${PG2_PORT}
backend_weight1 = 1
backend_flag1 = 'ALLOW_TO_FAILOVER'
backend_application_name1 = '${PG2_NAME}'

# ---------------------------------------------------------------- Conexiones
num_init_children = ${PGPOOL_NUM_INIT_CHILDREN}
max_pool = 1
child_life_time = 300
connection_life_time = 0
reserved_connections = 0

# ---------------------------------------------------------------- Autenticación
enable_pool_hba = on
pool_passwd = 'pool_passwd'
allow_clear_text_frontend_auth = off

# ---------------------------------------------------------------- Lectura distribuida
# SELECT fuera de transacciones de escritura se balancean entre primario y réplica
load_balance_mode = on
statement_level_load_balance = on
disable_load_balance_on_write = 'transaction'

# ---------------------------------------------------------------- Streaming replication check
sr_check_period = 2
sr_check_user = '${PGPOOL_SR_CHECK_USER}'
sr_check_password = '${PGPOOL_SR_CHECK_PASSWORD}'
sr_check_database = 'postgres'
delay_threshold = 10000000

# ---------------------------------------------------------------- Health check (detección de fallas)
# Detección de caída en ~ period + timeout + max_retries*retry_delay = 2 + 2 + 2*1 ≈ 6 s
health_check_period = 2
health_check_timeout = 2
health_check_user = '${PGPOOL_SR_CHECK_USER}'
health_check_password = '${PGPOOL_SR_CHECK_PASSWORD}'
health_check_database = 'postgres'
health_check_max_retries = 2
health_check_retry_delay = 1
connect_timeout = 3000

# ---------------------------------------------------------------- Failover automático
failover_command = '/opt/pgpool/failover.sh %d %h %p %m %H %r %P %M'
failback_command = '/opt/pgpool/failback.sh %d %h %p'
follow_primary_command = ''
failover_on_backend_error = on
failover_on_backend_shutdown = on
search_primary_node_timeout = 30
# Un ex-primario que vuelve como réplica sana se reincorpora solo
auto_failback = on
auto_failback_interval = 15
# Si aparecieran 2 primarios, se desconecta el que no corresponde (anti split-brain)
detach_false_primary = on

# ---------------------------------------------------------------- Watchdog (2 instancias de Pgpool)
# Coordina el estado de los backends entre pgpool-1 y pgpool-2 para que solo el
# líder ejecute el failover. Sin IP virtual: los clientes (Módulo B) usan
# conexión multi-host de libpq "pgpool-1,pgpool-2".
use_watchdog = on
hostname0 = '${PGPOOL1_HOST}'
wd_port0 = ${PGPOOL1_WD_PORT}
pgpool_port0 = ${PGPOOL1_PORT}
hostname1 = '${PGPOOL2_HOST}'
wd_port1 = ${PGPOOL2_WD_PORT}
pgpool_port1 = ${PGPOOL2_PORT}
wd_ipc_socket_dir = '/tmp'
delegate_ip = ''
wd_priority = ${PGPOOL_WD_PRIORITY}
wd_lifecheck_method = 'heartbeat'
wd_interval = 2
heartbeat_hostname0 = '${PGPOOL1_HOST}'
heartbeat_port0 = ${PGPOOL1_HB_PORT}
heartbeat_hostname1 = '${PGPOOL2_HOST}'
heartbeat_port1 = ${PGPOOL2_HB_PORT}
wd_heartbeat_keepalive = 2
wd_heartbeat_deadtime = 6
failover_when_quorum_exists = on
failover_require_consensus = on
allow_multiple_failover_requests_from_node = off
# Con 2 instancias, 1 voto (la mitad) basta: si cae un Pgpool el otro sigue operando
enable_consensus_with_half_votes = on
