# Los scripts se ejecutan dentro de contenedores Linux: forzar fin de línea LF
# aunque el repo se clone en Windows (core.autocrlf=true rompería los .sh).
*.sh        text eol=lf
*.conf      text eol=lf
*.sql       text eol=lf
*.js        text eol=lf
*.go        text eol=lf
*.py        text eol=lf
Dockerfile  text eol=lf
*.ps1       text eol=crlf
